generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int      @id @default(autoincrement())
  email    String   @unique
  name     String?
  phone    String?
  password String
  role     Role     @default(TENANT)
  Rental   Rental[]
  Maintenance Maintenance[]
}

model Office {
  id         Int          @id @default(autoincrement())
  officeNo   String       @unique
  floorNo    Int
  rentAmount Float
  officeArea String
  status     OfficeStatus @default(available)
  Rental     Rental[]
  Maintenance Maintenance[]
}

model Rental {
  id         Int       @id @default(autoincrement())
  tenantId   Int
  officeId   Int
  startDate  DateTime
  endDate    DateTime?
  rentAmount Float
  office     Office    @relation(fields: [officeId], references: [id])
  tenant     User      @relation(fields: [tenantId], references: [id])

  payment Payment[]
}

model Maintenance {
  id          Int               @id @default(autoincrement())
  officeId    Int
  tenantId    Int
  description String
  startDate   DateTime          @default(now())
  status      MaintenanceStatus @default(in_progress)
  Office      Office            @relation(fields: [officeId], references: [id])
  User        User              @relation(fields: [tenantId], references: [id])
}

model Announcement {
  id         Int      @id @default(autoincrement())
  title      String
  content    String
  createdAt  DateTime @default(now())
  expiryDate DateTime
}

model Payment {
  id          Int           @id @default(autoincrement())
  rentalId    Int
  amount      Float
  paymentDate DateTime      @default(now())
  status      PaymentStatus @default(pending)
  rental      Rental        @relation(fields: [rentalId], references: [id])
}

enum Role {
  ADMIN
  TENANT
}

enum OfficeStatus {
  available
  rented
  maintenance
}

enum PaymentStatus {
  pending
  payed
  overdue
}

enum MaintenanceStatus {
  open
  in_progress
  resolved
}
